# ===========================================================================
# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，绝不进版本库。
#   cp .env.example .env
# 所有密钥只在这一个文件里；代码侧统一由 config.py 读成 SecretStr，
# 业务层（workflow / experts / rag）拿不到明文。
# ===========================================================================

# ---- LLM (DeepSeek, OpenAI-compatible) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled | enabled
DEEPSEEK_THINKING=disabled
LLM_TEMPERATURE=0.0
# 单次调用的输出上限。**方案生成节点**要写一份带正文与逐条依据的方案，是所有产物里最长的一个：
# 2048 把方案 JSON 截断在半句上（`Expecting ',' delimiter ... char 3507`），4096 仍不够
# （截断点移到 char 7943）→ 契约重试耗尽、回落模板。见 D-101。
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_S=120

# ---- Embedding (智谱 Embedding-3, OpenAI-compatible) ----
# 申请地址：https://open.bigmodel.cn/  →  API Keys
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
# embedding-3 支持 2048 / 1024 / 512 / 256；改动后必须重建 Qdrant 集合
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_S=60

# ---- Qdrant（向量库，docker compose 启动） ----
# 端口不是随便定的：Windows 会保留一段 TCP 区间（`netsh int ipv4 show excludedportrange
# protocol=tcp`，典型是 6264-6363），落在其中的端口 Docker **绑不上**，表现为
# `bind: An attempt was made to access a socket in a way forbidden by its access permissions`
# ——容器照样 Up、`docker inspect` 里也有 PortBindings，但 `docker port` 为空、宿主连不上。
# 6333 常在这段区间里，故沿用 16333。换端口时记得同步 QDRANT_URL。
QDRANT_HTTP_PORT=16333
QDRANT_URL=http://localhost:16333
QDRANT_COLLECTION=ec_renew_change_orders
# 本地实验默认不鉴权；若开启，需同时取消 docker-compose.yml 里对应注释
QDRANT_API_KEY=

# ---- Neo4j（图库，docker compose 启动） ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# compose 里的 NEO4J_AUTH 也读这个值，两处必须一致
NEO4J_PASSWORD=changeme

# ---- Retrieval ----
TOP_K=12
# auto | llamaindex | graph | memory
RAG_BACKEND=auto
RRF_K=60
GRAPH_TOP_K=12
# 纯向量命中要多高的相似度才算「真实历史案例」。
# 0 = 关闭：向量检索总会返回 top-k，仅凭此宣称有历史依据会把
#     knowledge_based 误抬成 history_backed。
# 实测参考（本语料 118 单 + 智谱 embedding-3，36 条标注 query）：
#     域内 top1 ∈ [0.3551, 0.4741]   域外 top1 ∈ [0.1082, 0.3390]
#     → 0.35 落在空隙正中（域内 16/16 通过，域外 0/20 误放）。
# ⚠ embedding-3 的余弦分布整体偏压缩（约 0.1~0.47），不要凭直觉设 0.5/0.8，
#   那会把绝大多数真实命中拒掉。换语料或换模型后请重新标定。
VECTOR_MIN_SCORE=0.35
# 三元组抽取器：rule（确定性规则，默认，无需 LLM）| llm（LlamaIndex 的 SchemaLLMPathExtractor）
# llm 只对**没有字段标签**的自由文本有意义；本语料字段已带标签，rule 更准更省。
KG_EXTRACTOR=rule

# ---- Corpus ----
DATA_DIR=data
CORPUS_FILE=zahuo.txt
# 变更单分隔符（正则）。默认值已内置，一般不需要改。
# CORPUS_SEPARATOR=!@#\$%\^&\*

# ---- Workflow ----
MAX_ROUNDS=3
CONSENSUS_THRESHOLD=0.6
MIN_EFFECTIVE_EXPERTS=3

# ---- Cache / events ----
CACHE_ENABLED=true
CACHE_DIR=.cache/llm
EVENTS_PATH=logs/events.jsonl
